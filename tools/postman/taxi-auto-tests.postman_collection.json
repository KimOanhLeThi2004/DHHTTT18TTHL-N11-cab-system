      "name": "Init Variables",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const ts = Date.now();",
              "const rnd = Math.floor(Math.random() * 100000);",
              "if (!pm.collectionVariables.get('customerEmail')) pm.collectionVariables.set('customerEmail', `postman_customer_${ts}_${rnd}@test.com`);",
              "if (!pm.collectionVariables.get('customerPassword')) pm.collectionVariables.set('customerPassword', `Pass@${ts}`);",
              "if (!pm.collectionVariables.get('driverEmail')) pm.collectionVariables.set('driverEmail', `postman_driver_${ts}_${rnd}@test.com`);",
              "if (!pm.collectionVariables.get('driverPassword')) pm.collectionVariables.set('driverPassword', `Pass@${ts}`);",
              "pm.collectionVariables.set('idempotencyKey', `idem-${ts}-${rnd}`);",
              "pm.collectionVariables.set('idempPickupLat', '10.7600');",
              "pm.collectionVariables.set('idempPickupLng', '106.6600');",
              "pm.collectionVariables.set('idempDropLat', '10.7700');",
              "pm.collectionVariables.set('idempDropLng', '106.7000');",
              "const baseLat = 11 + (Math.random() * 0.01);",
              "const baseLng = 106 + (Math.random() * 0.01);",
              "pm.collectionVariables.set('assignLat', baseLat.toFixed(6));",
              "pm.collectionVariables.set('assignLng', baseLng.toFixed(6));",
              "pm.collectionVariables.set('assignDropLat', (baseLat + 0.001).toFixed(6));",
              "pm.collectionVariables.set('assignDropLng', (baseLng + 0.001).toFixed(6));",
              "pm.collectionVariables.set('aiDriver1Id', `DRV_AI_${ts}`);",
              "pm.collectionVariables.set('aiDriver2Id', `DRV_AI_${ts + 1}`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Health check reachable', function () {",
              "  pm.response.to.have.status(200);",
              "});"
            ]
