    {
      "name": "Expired Token -> 401",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 401', function () {",
              "  pm.response.to.have.status(401);",
              "});",
              "let j = {};",
              "try { j = pm.response.json(); } catch (e) {}",
              "const expiredToken = pm.collectionVariables.get('expiredToken') || '';",
              "if (expiredToken && expiredToken !== 'expired_token') {",
              "  pm.test('Message Token expired', function () {",
              "    pm.expect(j.message).to.eql('Token expired');",
              "  });",
              "}",
              "pm.test('Request is rejected before business output', function () {",
              "  ['booking_id', 'status', 'fare', 'driver_id'].forEach(function (k) {",
              "    pm.expect(j).to.not.have.property(k);",
              "  });",
              "});"
            ]
          }
        }
      ],
