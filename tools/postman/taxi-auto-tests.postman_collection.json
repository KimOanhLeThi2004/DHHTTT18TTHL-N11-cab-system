              "});",
              "const body = pm.response.json();",
              "const selected = body.selected_driver || {};",
              "const selectedId = String(selected.id || '');",
              "const onlineMap = JSON.parse(pm.collectionVariables.get('nearbyOnlineMap') || '{}');",
              "const status = String(selected.status || onlineMap[selectedId] || '').toUpperCase();",
              "pm.test('Selected driver exists', function () {",
              "  pm.expect(selectedId).to.not.eql('');",
              "});",
              "pm.test('Selected driver belongs to nearby list and online', function () {",
              "  pm.expect(Object.prototype.hasOwnProperty.call(onlineMap, selectedId)).to.eql(true);",
              "  pm.expect(status).to.eql('ONLINE');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"strategy\": \"nearest\",\n  \"drivers\": {{nearbyDriversJson}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/ai/agent/select-driver"
      },
      "response": []
    },
    {
      "name": "Assignment Driver Online (For Latency Test)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Assignment driver online success', function () {",
              "  pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"driverId\": \"{{driverUserId}}\",\n  \"lat\": {{assignLat}},\n  \"lng\": {{assignLng}},\n  \"vehicleType\": \"CAR\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/drivers/online"
      },
      "response": []
    },
    {
      "name": "Create Booking For Assignment Latency",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Booking created for assignment test', function () {",
              "  pm.expect([200, 201]).to.include(pm.response.code);",
              "});",
              "const j = pm.response.json();",
              "const bookingId = j.booking_id || j._id || '';",
              "const bookingStatus = String(j.status || '').toUpperCase();",
              "pm.collectionVariables.set('assignBookingId', bookingId);",
              "pm.collectionVariables.set('assignBookingStatus', bookingStatus);",
              "pm.collectionVariables.set('assignStartMs', String(Date.now()));",
              "pm.collectionVariables.set('assignPollTries', '0');",
              "pm.test('Booking id captured', function () {",
              "  pm.expect(bookingId).to.not.eql('');",
              "});",
              "pm.test('Booking must not be FAILED for assignment flow', function () {",
              "  pm.expect(bookingStatus).to.not.eql('FAILED');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{customerToken}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "assign-{{idempotencyKey}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"pickup\": { \"lat\": {{assignLat}}, \"lng\": {{assignLng}} },\n  \"dropoff\": { \"lat\": {{assignDropLat}}, \"lng\": {{assignDropLng}} },\n  \"distanceKm\": 2,\n  \"durationMin\": 4,\n  \"vehicleType\": \"CAR\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/booking"
      },
      "response": []
    },
    {
      "name": "Poll Driver Accept (Assignment Latency)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const tries = Number(pm.collectionVariables.get('assignPollTries') || 0);",
              "const intervalMs = Number(pm.collectionVariables.get('assignPollIntervalMs') || 300);",
              "if (tries > 0 && intervalMs > 0) {",
              "  const start = Date.now();",
              "  while (Date.now() - start < intervalMs) {}",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const status = pm.response.code;",
              "let body = {};",
              "try { body = pm.response.json(); } catch (e) {}",
              "const startMs = Number(pm.collectionVariables.get('assignStartMs') || Date.now());",
              "const elapsedMs = Date.now() - startMs;",
              "const maxLatencyMs = Number(pm.collectionVariables.get('assignMaxLatencyMs') || 5000);",
              "const maxPollTries = Number(pm.collectionVariables.get('assignMaxPollTries') || 25);",
              "const tries = Number(pm.collectionVariables.get('assignPollTries') || 0);",
              "const accepted = status === 200 && /accepted/i.test(String(body.message || ''));",
              "",
              "if (accepted) {",
              "  pm.test('Driver accepted assigned booking', function () {",
              "    pm.expect(accepted).to.eql(true);",
              "  });",
              "  pm.test('Assignment latency within threshold', function () {",
              "    pm.expect(elapsedMs).to.be.below(maxLatencyMs + 1);",
              "  });",
              "  pm.collectionVariables.set('assignLatencyMs', String(elapsedMs));",
              "  pm.execution.setNextRequest(null);",
              "} else {",
              "  const msg = String(body.message || '').toLowerCase();",
              "  const retriable = status === 400 && msg.includes('assignment expired or not found');",
              "  const canRetry = retriable && elapsedMs < maxLatencyMs && tries < maxPollTries;",
              "  if (canRetry) {",
              "    pm.collectionVariables.set('assignPollTries', String(tries + 1));",
              "    pm.execution.setNextRequest('Poll Driver Accept (Assignment Latency)');",
              "  } else {",
              "    pm.test('Driver receives assignment within latency SLO', function () {",
              "      pm.expect.fail(`Assignment not accepted in time. status=${status}, body=${JSON.stringify(body)}, elapsedMs=${elapsedMs}, tries=${tries}`);",
              "    });",
              "    pm.execution.setNextRequest(null);",
              "  }",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{driverToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"bookingId\": \"{{assignBookingId}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/drivers/accept"
      },
      "response": []
    }
  ]
}