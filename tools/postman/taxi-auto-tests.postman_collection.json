    {
      "name": "Large Payload -> 413",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const huge = 'x'.repeat(1024 * 1024 + 10);",
              "const payload = {",
              "  pickup: { lat: 10.76, lng: 106.66 },",
              "  dropoff: { lat: 10.77, lng: 106.70 },",
              "  distanceKm: 5,",
              "  durationMin: 10,",
              "  vehicleType: 'CAR',",
              "  note: huge",
              "};",
              "pm.collectionVariables.set('largePayload', JSON.stringify(payload));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 413 Payload Too Large', function () {",
              "  pm.response.to.have.status(413);",
              "});",
              "let j = {};",
              "try { j = pm.response.json(); } catch (e) {}",
              "pm.test('No business output for rejected request', function () {",
              "  ['booking_id', 'status', 'price'].forEach(function (k) {",
              "    pm.expect(j).to.not.have.property(k);",
              "  });",
              "});"
            ]
          }
        }
