              "  pm.expect(arr.length).to.be.above(0);",
              "});",
              "pm.collectionVariables.set('nearbyDriversJson', JSON.stringify(arr));",
              "const onlineMap = {};",
              "arr.forEach(function (d) {",
              "  if (d && d.id) onlineMap[String(d.id)] = String(d.status || '').toUpperCase();",
              "});",
              "pm.collectionVariables.set('nearbyOnlineMap', JSON.stringify(onlineMap));"
