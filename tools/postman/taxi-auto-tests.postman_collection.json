    {
      "name": "Pricing demand_index=0",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const j = pm.response.json();",
              "const surge = (j.surge_multiplier !== undefined) ? j.surge_multiplier : j.surgeMultiplier;",
              "const total = (j.total_price !== undefined) ? j.total_price : j.totalPrice;",
              "pm.test('Surge >= 1', function () {",
              "  pm.expect(surge).to.be.at.least(1);",
              "});",
              "pm.test('Price is valid > 0', function () {",
              "  pm.expect(total).to.be.above(0);",
              "});",
              "pm.test('No division-by-zero NaN/Infinity', function () {",
              "  pm.expect(Number.isFinite(surge)).to.eql(true);",
              "  pm.expect(Number.isFinite(total)).to.eql(true);",
              "});"
            ]
          }
        }
      ],
