    {
      "name": "Fraud Missing Fields -> 400 + No Model",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400', function () {",
              "  pm.response.to.have.status(400);",
              "});",
              "const j = pm.response.json();",
              "pm.test('Message is missing required fields', function () {",
              "  pm.expect(j.message).to.eql('missing required fields');",
              "});",
              "pm.test('Missing fields list includes required keys', function () {",
              "  ['driver_id', 'booking_id', 'amount', 'location', 'device_fingerprint'].forEach(function (k) {",
              "    pm.expect(j.missing || []).to.include(k);",
              "  });",
              "});",
              "pm.test('No model output in validation failure', function () {",
              "  pm.expect(j).to.not.have.property('fraud_score');",
              "  pm.expect(j).to.not.have.property('flagged');",
              "  pm.expect(j).to.not.have.property('model_version');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
