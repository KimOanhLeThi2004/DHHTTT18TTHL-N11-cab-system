NODE_ENV=development
PORT=3003

# Postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=driver_service
DB_USER=driver
DB_PASSWORD=driver

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Mongo
MONGO_URI=mongodb://localhost:27017/driver_service

# JWT
JWT_SECRET=driver_service_secret
JWT_EXPIRES_IN=1d

# Broker
BROKER_TYPE=rabbitmq
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=driver.events
RABBITMQ_QUEUE=driver-service
RABBITMQ_DLQ=driver-service.dlq

KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=driver-service
KAFKA_GROUP_ID=driver-service-group
KAFKA_TOPIC=driver.events

# Rate limit (giay)
LOCATION_RATE_LIMIT_TTL=3
LOCATION_RATE_LIMIT_LIMIT=1
