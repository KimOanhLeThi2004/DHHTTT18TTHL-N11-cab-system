PORT=3010
KAFKA_BROKERS=kafka:29092
REDIS_URL=redis://redis:6379
FRAUD_THRESHOLD=0.7
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_MS=15000
OLLAMA_MAX_CANDIDATES=8
OLLAMA_MCP_ENABLED=true
OLLAMA_MCP_COMMAND=node
OLLAMA_MCP_ARGS=["./ollamaMcpServer.js"]
OLLAMA_MCP_TOOL=ollama.generate
AGENT_ETA_RETRIES=2
AGENT_ETA_RETRY_BACKOFF_MS=120
OLLAMA_MCP_FORCE_ERROR=false
OLLAMA_MCP_FORCE_ERROR_COUNT=0
OLLAMA_MCP_FORCE_DELAY_MS=0
